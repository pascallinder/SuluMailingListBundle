<mjml>
    <mj-head>
        <mj-title>
            {% block title %}
            {% endblock %}
        </mj-title>
        {% set defaultFont = fonts|filter(f => f.defaultFont)|first %}
        {% block css %}
            <mj-style>
                body,
                table,
                td,
                div,
                p,
                a {
                    -webkit-text-size-adjust: 100%;
                    -ms-text-size-adjust: 100%;
                    text-size-adjust: 100%;
                }
                .mjml-text-container *{
                    text-align: inherit;
                }
                .mjml-text-container a {
                    color: inherit !important;
                }
                .mjml-text-container *:first-child{
                    margin-top: 0;
                }
                .mjml-text-container *:last-child{
                    margin-bottom: 0;
                }
                {% if defaultFont is defined and defaultFont is not null %}
                    a[href="url"]{
                        font-family: {{defaultFont.fontFamily|default}};
                    }
                {% endif %}
            </mj-style>
        {% endblock %}
        {% block additonal_css %}
        {% endblock %}
        {% block fonts %}

            {% if fonts is defined and fonts is not null %}
                {% for font in fonts %}
                    <mj-font href="{{ font.cssUrl }}" name="{{ font.name }}" />
                {% endfor %}
            {% endif %}
        {% endblock %}

        <mj-attributes>
            {% if defaultFont is defined and defaultFont is not null %}
                <mj-all font-family="{{ defaultFont.fontFamily|default }}" />
            {% endif %}
            {% block addtional_attributes %}
            {% endblock %}
        </mj-attributes>
        {% block additional_head %}
        {% endblock %}

    </mj-head>
    <mj-body background-color="{{ backgroundColor|default }}" >
        <mj-section>
            <mj-column>
                <mj-chart chs="700x200" chd="s:theresadifferencebetweenknowingthepathandwalkingthepath" cht="bvs" chxt="y" chf="b0,lg,90,4CA4F5,0.1,C371D3,0.8,EA469E,1" />
            </mj-column>
        </mj-section>
        {% block header %}
            {% if headerTemplate is defined and headerTemplate.content is defined and headerTemplate.content is not null %}
                {% for wrapper in headerTemplate.content %}
                    {% include '@SuluMailingList/mails/wrappers/' ~ wrapper.type ~ '.mjml.twig' with {
                        wrapper: wrapper,
                        backgroundColor: headerTemplate.backgroundColor|default(backgroundColor|default(null))
                    } %}
                {% endfor %}
            {% endif %}
        {% endblock %}
        {% block content %}
            {% if content is defined and content is not null %}
                {% for wrapper in content %}
                    {% include '@SuluMailingList/mails/wrappers/' ~ wrapper.type ~ '.mjml.twig' with {
                        wrapper: wrapper
                    } %}
                {% endfor %}
            {% endif %}
        {% endblock %}
        {% block footer %}
            {% if footerTemplate is defined and footerTemplate.content is defined and footerTemplate.content is not null %}
                {% for wrapper in footerTemplate.content %}
                    {% include '@SuluMailingList/mails/wrappers/' ~ wrapper.type ~ '.mjml.twig' with {
                        wrapper: wrapper,
                        backgroundColor: footerTemplate.backgroundColor|default(backgroundColor|default(null))
                    } %}
                {% endfor %}
            {% endif %}
        {% endblock %}
    </mj-body>
</mjml>
